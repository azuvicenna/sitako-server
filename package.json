{
  "name": "sitako",
  "version": "1.0.0",
  "description": "Sistem Informasi Perpustakaan Sekolah (SITAKO) Backend",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:feature": "jest tests/feature",
    "k6:smoke": "k6 run tests/load/scenarios/01_smoke.js",
