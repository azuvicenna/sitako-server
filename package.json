    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "svg-captcha": "^1.4.0",
    "typst": "^0.10.0-8",
    "ulid": "^3.0.2",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
