    "k6:spike": "k6 run tests/load/scenarios/06_spike.js",
    "k6:soak": "k6 run tests/load/scenarios/07_soak.js",
    "k6:breakpoint": "k6 run tests/load/scenarios/08_breakpoint.js",
    "k6:write": "k6 run tests/load/scenarios/09_write_lifecycle.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
