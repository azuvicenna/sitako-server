APP_NAME=SITAKO-backend
APP_ENV=production
NODE_ENV=production
PORT=8080
APP_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Set false jika deploy di VM lokal tanpa HTTPS agar cookie login/captcha tidak diblokir browser
COOKIE_SECURE=false

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
# Opsional: diisi jika ingin override dengan connection string penuh (misal: Supabase/Neon/RDS)
DATABASE_URL=

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
# Opsional: diisi jika ingin override dengan redis connection string penuh (misal: Upstash)
REDIS_URL=

# Monitoring & Infra Ports (Docker Compose)
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
PROMETHEUS_PORT=9091
# Opsional: Port untuk Load Balancer Nginx (jika diaktifkan)
# LB_PORT=80

JWT_SECRET=
CAPTCHA_SECRET=

TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_API_URL=https://tripay.co.id/api-sandbox/

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=email-kamu@gmail.com
MAIL_PASS=app-password-kamu
MAIL_FROM=email-kamu@gmail.com

S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=sitako-bucket
PUBLIC_STORAGE_URL=https://pub-xxxxxx.r2.dev