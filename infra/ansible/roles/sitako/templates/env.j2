# =============================================================================
# Konfigurasi Environment SITAKO Backend (Digenerate oleh Ansible)
# Jangan edit file ini secara manual di server; ubah melalui Ansible group_vars.
# =============================================================================

APP_NAME={{ app_name }}
APP_ENV={{ app_env }}
NODE_ENV={{ node_env }}
PORT={{ app_port }}
APP_URL={{ app_url }}
ALLOWED_ORIGIN={{ allowed_origin }}
LOG_LEVEL={{ log_level }}
COOKIE_SECURE={{ cookie_secure }}

# Database (PostgreSQL)
POSTGRES_HOST={{ postgres_host }}
POSTGRES_PORT={{ postgres_port }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
DATABASE_URL={{ database_url }}

# Cache (Redis)
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}
REDIS_URL={{ redis_url }}

# Monitoring & Infra Ports (Docker Compose)
POSTGRES_EXPORTER_PORT={{ postgres_exporter_port }}
REDIS_EXPORTER_PORT={{ redis_exporter_port }}
PROMETHEUS_PORT={{ prometheus_port }}
LB_PORT={{ lb_port }}

# Auth & Security Secrets
JWT_SECRET={{ jwt_secret }}
CAPTCHA_SECRET={{ captcha_secret }}

# Tripay Payment Gateway
TRIPAY_API_KEY={{ tripay_api_key }}
TRIPAY_PRIVATE_KEY={{ tripay_private_key }}
TRIPAY_MERCHANT_CODE={{ tripay_merchant_code }}
TRIPAY_API_URL={{ tripay_api_url }}

# Mailer (SMTP)
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_USER={{ mail_user }}
MAIL_PASS={{ mail_pass }}
MAIL_FROM={{ mail_from }}

# S3 / Cloudflare R2 Object Storage
S3_ENDPOINT={{ s3_endpoint }}
S3_ACCESS_KEY_ID={{ s3_access_key_id }}
S3_SECRET_ACCESS_KEY={{ s3_secret_access_key }}
S3_BUCKET_NAME={{ s3_bucket_name }}
PUBLIC_STORAGE_URL={{ public_storage_url }}
