# Application
APP_NAME=sitako-server
APP_ENV=test
NODE_ENV=test
PORT=8080
APP_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sitako_test
DATABASE_URL=postgresql://postgres:password@localhost:5432/sitako_test

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Monitoring Ports
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
PROMETHEUS_PORT=9091

# Auth & Security
JWT_SECRET=test-secret-key-for-jest
CAPTCHA_SECRET=captcha_default_secret

# Payment Gateway (Tripay)
TRIPAY_API_KEY=test-api-key
TRIPAY_PRIVATE_KEY=test-private-key
TRIPAY_MERCHANT_CODE=TEST123
TRIPAY_API_URL=https://tripay.co.id/api-sandbox/

# Mail Service
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=test@gmail.com
MAIL_PASS=test-password
MAIL_FROM=test@gmail.com

# Object Storage (Cloudflare R2 / S3)
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=test-access-key-id
S3_SECRET_ACCESS_KEY=test-secret-access-key
S3_BUCKET_NAME=sitako-bucket-test
PUBLIC_STORAGE_URL=https://pub-test.r2.dev
